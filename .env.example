# Copy to .env and `set -a; source .env` before `npm start`, or put these in the
# launchd plist. All optional.

# Use pairing-code login instead of QR (your number, digits only, with country code)
#CLAUDE_OFFICE_PAIRING_PHONE=91XXXXXXXXXX

# Extra WhatsApp senders allowed to command the agent (besides your own self-chat)
#CLAUDE_OFFICE_ALLOWED_SENDERS=919876543210@s.whatsapp.net

# Model override (default: your Claude Code settings default)
#CLAUDE_OFFICE_MODEL=claude-opus-5

# Forward Claude's progress notes between tool calls (default true)
#CLAUDE_OFFICE_PROGRESS=true
# One line per tool call (default false; noisy)
#CLAUDE_OFFICE_VERBOSE_TOOLS=false
# Minutes to wait for an approval/answer before treating it as "no" (default 60)
#CLAUDE_OFFICE_APPROVAL_TIMEOUT_MIN=60
# Max agentic turns per instruction (default 300)
#CLAUDE_OFFICE_MAX_TURNS=300
# Don't post the "Online" message on startup
#CLAUDE_OFFICE_QUIET=false
